# ==============================================================================
# Vaultwarden + Vaultwarden-Backup 環境變數範本
# 使用前請執行：
#   cp .env.example .env
#   cp rclone/rclone.conf.example rclone/rclone.conf
# 注意：若密碼或 Token 內含 `$` 字元（如 $argon2id$...），請務必用單引號 '...' 包起來
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Vaultwarden 核心設定
# ------------------------------------------------------------------------------

# [必填] 備份壓縮加密密碼（建議至少 16 字元；留空或未建立 .env 時 compose 啟動會阻擋提醒）
# 請使用單引號包住含特殊字元的密碼，例如：ZIP_PASSWORD='My-Strong-Password!'
ZIP_PASSWORD=

# 對外存取網址（含協定；未完成 HTTPS 反向代理前可先維持預設）
# 設定完 Synology 反向代理與憑證後，請改為實際 HTTPS 網址，例如：
# DOMAIN=https://vw.yourname.synology.me
DOMAIN=http://localhost:8200

# NAS 映射設定（預設 8200 以避開 LibreTV 的 8080 與 novel 的 3000）
# 完成 Synology 本機反向代理後，建議將 VAULTWARDEN_BIND_IP 改為 127.0.0.1，避免區網直接連 HTTP
VAULTWARDEN_BIND_IP=0.0.0.0
VAULTWARDEN_PORT=8200

# 是否開放新帳號註冊（第一次註冊好個人帳號後，請改為 false 並重啟專案以防他人註冊！）
SIGNUPS_ALLOWED=true

# 是否允許組織管理員發送邀請
INVITATIONS_ALLOWED=true

# 管理後台 (/admin) 存取 Token（留空則關閉 /admin 後台，安全性更高）
# 建議使用 Argon2id 雜湊格式，注意必須使用單引號：
# ADMIN_TOKEN='$argon2id$v=19$m=65540,t=3,p=4$...'
ADMIN_TOKEN=

# 登入頁是否顯示密碼提示
SHOW_PASSWORD_HINT=false

# 時區設定（台灣為 Asia/Taipei）
TZ=Asia/Taipei

# ------------------------------------------------------------------------------
# 2. Vaultwarden-Backup 自動備份設定（NAS 本機 + Google Drive 雙重備份）
# ------------------------------------------------------------------------------

# 備份排程（Cron 格式，預設每天台灣時間凌晨 03:00 執行一次）
# 若想每小時第 5 分鐘備份一次，可改為 "5 * * * *"
BACKUP_CRON="0 3 * * *"

# 備份保留天數（同時套用於 NAS ./backups 與 Google Drive；超過天數自動清理，設 0 為永久保留）
BACKUP_KEEP_DAYS=30

# 壓縮格式（支援 7z 與 zip；7z 支援標頭加密與更高壓縮率）
ZIP_TYPE=7z
ZIP_ENABLE=TRUE

# 備份檔時間後綴格式（含時分秒可避免同日多次備份互相覆蓋）
BACKUP_FILE_SUFFIX=%Y%m%d_%H%M%S

# 備份記錄與通知顯示名稱
DISPLAY_NAME=NAS-Vaultwarden

# 第一備份目標：NAS 本機 ./backups（對應 rclone/rclone.conf 內的 [BitwardenBackup]）
RCLONE_REMOTE_NAME=BitwardenBackup
RCLONE_REMOTE_DIR=/backups

# 第二備份目標：Google Drive 異地備份（對應 rclone/rclone.conf 內的 [GoogleDrive]）
# 啟動前請先依 README 步驟完成 rclone Google Drive 授權；
# 若想先僅用 NAS 本機備份啟動測試，請暫時將下方兩個值留空
RCLONE_REMOTE_NAME_1=GoogleDrive
RCLONE_REMOTE_DIR_1=/VaultwardenBackup

# 選填：Rclone 全域參數（預設 Google Drive 刪除舊備份時會進垃圾桶，屬安全緩衝）
# 若希望超過 BACKUP_KEEP_DAYS 直接永久刪除（不進垃圾桶），可設為：
# RCLONE_GLOBAL_FLAG=--drive-use-trash=false
RCLONE_GLOBAL_FLAG=

# 選填：健康檢查 / 通知 Webhook（如 Healthchecks.io、Uptime Kuma）
PING_URL_WHEN_SUCCESS=
PING_URL_WHEN_FAILURE=

# ------------------------------------------------------------------------------
# 3. 映像檔版本鎖定（選填，預設拉取 GHCR 官方最新多架構映像檔）
# ------------------------------------------------------------------------------
# VAULTWARDEN_IMAGE=ghcr.io/dani-garcia/vaultwarden:latest
# BACKUP_IMAGE=ghcr.io/ttionya/vaultwarden-backup:latest
